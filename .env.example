# ============================================
# InstaVest — Environment Variables
# ============================================
# Copy this file to backend/.env and fill in your values

# Database (not used in MVP — in-memory mock store)
DATABASE_URL=postgresql://instavest:instavest@db:5432/instavest
POSTGRES_USER=instavest
POSTGRES_PASSWORD=instavest
POSTGRES_DB=instavest

# Backend
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# AI Provider (leave empty to use template-based summaries)
ANTHROPIC_API_KEY=

# Data Providers (leave empty to use mock data)
FMP_API_KEY=
FRED_API_KEY=

# App Settings
APP_ENV=development
LOG_LEVEL=info
